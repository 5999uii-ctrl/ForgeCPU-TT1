; ForgeCPU-TT1 - first-silicon candidate for Tiny Tapeout SKY130
; 8-byte program RAM, 8-bit accumulator, 4 x 8-bit register file.
chip tt_um_forge01_forgecpu_tt1
in ui_in 8
outreg uo_out 8 0
in uio_in 8
out uio_out 8
out uio_oe 8
in ena 1
in clk 1
in rst_n 1

reg pc 3 0
reg acc 8 0
reg halted 1 0
regfile regs 4 8
mem prog 8 8
reg alu_out 8 0

local MODE_LOAD 0
local MODE_RUN 1
local MODE_INSPECT 2
local MODE_HOLD 3
local OP_NOP 0
local OP_LDI 1
local OP_ADDI 2
local OP_SUBI 3
local OP_XORI 4
local OP_ANDI 5
local OP_ORI 6
local OP_STORE 7
local OP_LOAD 8
local OP_JMP 9
local OP_JZ 10
local OP_INC 11
local OP_DEC 12
local OP_SHL 13
local OP_SHR 14
local OP_HALT 15

field mode 2 ui_in 7 6
field host_addr 3 ui_in 2 0
field inspect_sel 2 ui_in 1 0
field inspect_reg 2 ui_in 3 2
wire instr 8
comb instr = prog[pc]
field opcode 4 instr 7 4
field arg 4 instr 3 0
field regsel 2 instr 1 0

comb uio_out = 0
comb uio_oe = 0

alwayscomb
set alu_out = acc
case opcode
caseof OP_LDI
set alu_out = arg
endcaseof
caseof OP_ADDI
set alu_out = acc + arg
endcaseof
caseof OP_SUBI
set alu_out = acc - arg
endcaseof
caseof OP_XORI
set alu_out = acc ^ arg
endcaseof
caseof OP_ANDI
set alu_out = acc & arg
endcaseof
caseof OP_ORI
set alu_out = acc | arg
endcaseof
caseof OP_LOAD
set alu_out = regs[regsel]
endcaseof
caseof OP_INC
set alu_out = acc + 1
endcaseof
caseof OP_DEC
set alu_out = acc - 1
endcaseof
caseof OP_SHL
set alu_out = acc << 1
endcaseof
caseof OP_SHR
set alu_out = acc >> 1
endcaseof
defaultcase
set alu_out = acc
endcaseof
endcase
endcomb

alwayscomb
set uo_out = acc
case mode
caseof MODE_INSPECT
case inspect_sel
caseof 0
set uo_out = acc
endcaseof
caseof 1
set uo_out = pc
endcaseof
caseof 2
set uo_out = regs[inspect_reg]
endcaseof
caseof 3
set uo_out = halted
endcaseof
endcase
endcaseof
defaultcase
set uo_out = acc
endcaseof
endcase
endcomb

clock clk rising
when rst_n == 0
next pc = 0
next acc = 0
next halted = 0
elsewhen mode == MODE_LOAD && ena == 1
nextmem prog[host_addr] = uio_in
elsewhen mode == MODE_RUN && ena == 1 && halted == 0 && opcode == OP_HALT
next halted = 1
elsewhen mode == MODE_RUN && ena == 1 && halted == 0 && opcode == OP_JMP
next pc = arg[2:0]
elsewhen mode == MODE_RUN && ena == 1 && halted == 0 && opcode == OP_JZ && acc == 0
next pc = arg[2:0]
elsewhen mode == MODE_RUN && ena == 1 && halted == 0 && opcode == OP_STORE
nextmem regs[regsel] = acc
next pc = pc + 1
elsewhen mode == MODE_RUN && ena == 1 && halted == 0
next acc = alu_out
next pc = pc + 1
otherwise
next halted = halted
end
endclock
endchip
